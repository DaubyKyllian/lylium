# Compression + cache navigateur. Chaque bloc est protégé par <IfModule> :
# si un module manque, le site fonctionne quand même, sans l'optimisation.

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    # CSS/JS portent ?v=<date de modification> : cache long sans risque de version périmée
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(webp|jpe?g|png|svg|css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

# La base SQLite ne doit jamais être téléchargeable
<FilesMatch "\.(sqlite|sql)$">
    Require all denied
</FilesMatch>
